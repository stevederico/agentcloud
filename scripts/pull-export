#!/usr/bin/env python3
"""Pull a full export of the default calendar into a private folder, sealed,
and keep the newest N.

This is the backup that does not depend on the server: the export holds every
event, todo and note (with bodies), so it is enough to rebuild from. It carries
no keys or feed tokens.

The file is sealed with the calendar's own key (`agentcloud seal-file`, AES-256-GCM)
before it is written, so a copy of the folder, a synced disk or a backup drive
reveals nothing. Sealed items inside stay sealed. To read one:

  agentcloud open-file < almanac-cal_...-20261108T000000Z.alm

`open-file` also tries `previousKeys`, so exports from before a rotation open.

Reads the calendar from ~/.config/agentcloud/hosted-calendars.json, else the
old ~/.config/almanac/ (first entry, like the skill), and logs in with its auth
token. Never prints or logs either.

  AGENTCLOUD_BASE         default https://cloud.bixbyapps.com
  AGENTCLOUD_CREDS        default ~/.config/agentcloud/hosted-calendars.json
  AGENTCLOUD_BACKUP_DIR   default ~/.local/share/almanac-backups
  AGENTCLOUD_BACKUP_KEEP  default 30
  AGENTCLOUD_BIN          the agentcloud binary (else PATH, else ./target)
Each also reads the old ALMANAC_* name. The backup folder and file names keep
"almanac" so pruning still finds the copies made before the rename.

Exit status is non-zero on any failure and nothing already saved is touched, so
a scheduled run can be checked with `systemctl --user status` or a mail on
failure. Exports are limited to 10 per hour per calendar; once a day is plenty.
Plaintext `.json` exports from before 0.33.0 are left alone; delete them by hand.
"""
import datetime
import json
import os
import pathlib
import shutil
import subprocess
import sys
import urllib.error
import urllib.request


def fail(message):
    print(f"pull-export: {message}", file=sys.stderr)
    sys.exit(1)



def env(name, default=""):
    """AGENTCLOUD_<name>, else the old ALMANAC_<name>, else default."""
    for prefix in ("AGENTCLOUD_", "ALMANAC_"):
        value = os.environ.get(prefix + name, "").strip()
        if value:
            return value
    return default


def creds_path():
    chosen = env("CREDS")
    if chosen:
        return pathlib.Path(chosen).expanduser()
    new = pathlib.Path("~/.config/agentcloud/hosted-calendars.json").expanduser()
    if new.exists():
        return new
    return pathlib.Path("~/.config/almanac/hosted-calendars.json").expanduser()


def agentcloud_bin():
    chosen = env("BIN")
    if chosen:
        return chosen
    for name in ("agentcloud", "almanac"):
        found = shutil.which(name)
        if found:
            return found
    root = pathlib.Path(__file__).resolve().parent.parent / "target"
    for profile in ("release", "debug"):
        for name in ("agentcloud", "almanac"):
            built = root / profile / name
            if built.is_file() and os.access(built, os.X_OK):
                return str(built)
    return ""


def run(binary, args, stdin=b""):
    proc = subprocess.run([binary, *args], input=stdin, capture_output=True)
    if proc.returncode != 0:
        fail(f"agentcloud {args[0]} failed")
    return proc.stdout


def fetch(url, token):
    request = urllib.request.Request(
        url,
        # A real User-Agent: the host answers 403 to an empty or default one.
        headers={"Authorization": f"Bearer {token}", "User-Agent": "agentcloud-backup/1"},
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return 200, response.read()
    except urllib.error.HTTPError as e:
        return e.code, b""


def main():
    base = env("BASE", "https://cloud.bixbyapps.com").rstrip("/")
    creds = creds_path()
    dest = pathlib.Path(env("BACKUP_DIR", "~/.local/share/almanac-backups")).expanduser()
    try:
        keep = max(1, int(env("BACKUP_KEEP", "30")))
    except ValueError:
        fail("AGENTCLOUD_BACKUP_KEEP must be a whole number")

    try:
        entry = json.loads(creds.read_text())[0]
        cal_id, key = entry["id"], entry["key"]
    except (OSError, ValueError, IndexError, KeyError, TypeError):
        fail(f"could not read a calendar id and key from {creds}")
    binary = agentcloud_bin()
    if not binary:
        fail("needs the agentcloud binary to seal the export")
    os.environ["AGENTCLOUD_CREDS"] = os.environ["ALMANAC_CREDS"] = str(creds)
    token = run(binary, ["auth-token", "--cal", cal_id]).decode().strip()

    url = f"{base}/v1/c/{cal_id}/export?format=json"
    try:
        code, body = fetch(url, token)
        if code == 401:
            # A calendar from before 0.30.0 learns its token on one raw-key login.
            code, body = fetch(url, key)
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        fail(f"could not reach {base}: {getattr(e, 'reason', e)}")
    if code != 200:
        fail(f"the server answered {code}")

    # Refuse to save anything that is not a whole export: a truncated or
    # error body must not push a good backup out of the newest N.
    try:
        data = json.loads(body)
        counts = {name: len(data[name]) for name in ("events", "todos", "notes")}
    except (ValueError, KeyError, TypeError):
        fail("the response was not a complete export, nothing saved")
    sealed = run(binary, ["seal-file", "--cal", cal_id], body)
    if run(binary, ["open-file", "--cal", cal_id], sealed) != body:
        fail("the sealed copy did not open back to the export, nothing saved")
    body = sealed

    dest.mkdir(parents=True, exist_ok=True)
    os.chmod(dest, 0o700)
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    name = f"almanac-{cal_id}-{stamp}.alm"
    tmp = dest / f".{name}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(body)
    os.replace(tmp, dest / name)

    saved = sorted(dest.glob(f"almanac-{cal_id}-*.alm"))
    for old in saved[:-keep]:
        old.unlink()
    print(
        f"saved {name}: {counts['events']} events, {counts['todos']} todos, "
        f"{counts['notes']} notes, {len(body)} bytes sealed; keeping {min(len(saved), keep)}"
    )


if __name__ == "__main__":
    main()
